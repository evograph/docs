{
  "name": "evograph-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "generate:demo": "node scripts/generate-demo.mjs",
    "test": "node --test scripts/*.test.mjs",
    "generate:brand": "node scripts/generate-brand.mjs",
    "format": "prettier --write app components scripts data mdx-components.tsx next.config.mjs tsconfig.json eslint.config.mjs package.json README.md vercel.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.4.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@evograph/cli": "0.1.2",
    "@fontsource/dm-sans": "^5.3.0",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "fontkit": "^2.0.4",
    "prettier": "3.9.4",
    "sharp": "^0.35.5",
    "typescript": "6.0.3"
  }
}
